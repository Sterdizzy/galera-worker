{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gratis-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "secrets": {
    "required": [
      "GRATIS_ENROLLMENT_TOKEN",
      "GRATIS_TOKEN_SECRET"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "containers": [
    {
      "class_name": "GratisSandbox",
      "image": "docker.io/cloudflare/sandbox:0.13.0-next.751.1-python",
      "instance_type": "lite",
      "max_instances": 2,
      "name": "gratis-cloud-gratissandbox"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "GratisSandbox"
      },
      {
        "name": "CONTROL",
        "class_name": "GratisControl"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GratisSandbox",
        "GratisControl"
      ]
    }
  ]
}
